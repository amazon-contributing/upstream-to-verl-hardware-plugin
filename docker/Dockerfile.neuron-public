FROM ubuntu:26.04

COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /usr/local/bin/uv

# Public TorchNeuron wheels require GLIBC >= 2.43. Keep these userspace
# packages inside the container; the host supplies Neuron/EFA kernel drivers.
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg git build-essential python3 python3-venv \
    libhwloc15 libnuma1 libibverbs1 ibverbs-providers librdmacm1 libnl-3-200 libnl-route-3-200 \
    libgomp1 libglib2.0-0 libgl1 libarchive13t64 libssl3t64 libgfortran5 pciutils procps \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-driver-dev-12-6_12.6.77-1_amd64.deb \
    -o /tmp/cuda-driver-dev.deb \
    && echo "f5de67a0c72dae56eb81a12ef79eae9d7444255f1b3887c9920f5d8af362852a  /tmp/cuda-driver-dev.deb" | sha256sum -c - \
    && dpkg-deb -x /tmp/cuda-driver-dev.deb /opt/cuda-stubs \
    && ln -s /opt/cuda-stubs/usr/local/cuda-12.6/targets/x86_64-linux/lib/stubs/libcuda.so /usr/local/lib/libcuda.so.1 \
    && ldconfig && rm /tmp/cuda-driver-dev.deb
RUN curl -fsSL https://apt.repos.neuron.amazonaws.com/GPG-PUB-KEY-AMAZON-AWS-NEURON.PUB \
    | gpg --dearmor -o /usr/share/keyrings/aws-neuron.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/aws-neuron.gpg] https://apt.repos.neuron.amazonaws.com noble main" \
    > /etc/apt/sources.list.d/neuron.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    aws-neuronx-runtime-lib=2.35.30.0-d2725ccb8 \
    aws-neuronx-collectives=2.35.43.0-354ad3064 \
    aws-neuronx-tools=2.33.38.0-f874d5618 \
    && rm -rf /var/lib/apt/lists/*
# NRT 2.35's DMA-BUF path requires libfabric >= 2.4.0amzn5.0.
# Install only public EFA userspace packages; never install its kernel driver here.
RUN curl -fsSL https://efa-installer.amazonaws.com/aws-efa-installer-1.51.0.tar.gz \
    -o /tmp/efa.tar.gz \
    && echo "83993044fa4df3dc2f8b5c2f7051d61b9689441be023a2c92ea51d3f53f2465c  /tmp/efa.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/efa.tar.gz -C /tmp \
    aws-efa-installer/DEBS/UBUNTU2604/x86_64/libfabric1-aws_2.7.0amzn2.0_amd64.deb \
    aws-efa-installer/DEBS/UBUNTU2604/x86_64/libfabric-aws-bin_2.7.0amzn2.0_amd64.deb \
    aws-efa-installer/DEBS/UBUNTU2604/x86_64/rdma-core/libibverbs1_65.0-1_amd64.deb \
    aws-efa-installer/DEBS/UBUNTU2604/x86_64/rdma-core/ibverbs-providers_65.0-1_amd64.deb \
    aws-efa-installer/DEBS/UBUNTU2604/x86_64/rdma-core/librdmacm1_65.0-1_amd64.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
    /tmp/aws-efa-installer/DEBS/UBUNTU2604/x86_64/*.deb \
    /tmp/aws-efa-installer/DEBS/UBUNTU2604/x86_64/rdma-core/*.deb \
    && rm -rf /tmp/efa.tar.gz /tmp/aws-efa-installer /var/lib/apt/lists/*
# TorchNeuron's affinity helper loads the unversioned libnuma.so name.
RUN apt-get update && apt-get install -y --no-install-recommends libnuma-dev \
    && rm -rf /var/lib/apt/lists/*
ENV TORCH_DEVICE_BACKEND_AUTOLOAD=0 \
    NEURON_LOGICAL_NC_CONFIG=2 \
    LD_LIBRARY_PATH=/opt/aws/neuron/lib:/opt/amazon/efa/lib:/opt/amazon/efa/lib64 \
    PATH=/opt/aws/neuron/bin:/opt/amazon/efa/bin:${PATH}
